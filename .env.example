# このファイルは設定の見本です。
# 使うときは、このファイルをコピーして「.env.local」という名前にし、
# 右側を自分のSupabaseの値に書き換えてください。
# ※ .env.local はGitにコミットされないよう .gitignore で除外済みです。

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstileの公開サイトキー（秘密鍵はここに書かない）
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
